// m = 4, normalized: z^4 + q2 z^2 + q1 z + q0 = (u2 z^2 + u1 z + u0)^2
ring r4=0,(u2,u1,u0,q2,q1,q0),dp;
ideal I4 = u2^2-1, 2*u2*u1, 2*u2*u0+u1^2-q2, 2*u1*u0-q1, u0^2-q0;
ideal E4 = eliminate(I4, u2*u1*u0);
"E4 (computed):"; print(std(E4));
ideal C4 = q1, 4*q0-q2^2;
"E4 == (q1, 4q0-q2^2):"; print(size(reduce(E4,std(C4)))==0 && size(reduce(C4,std(E4)))==0);
"radical?"; LIB "primdec.lib"; print(size(reduce(radical(C4),std(C4)))==0);
// m = 2, normalized: q2 z^2 + q0 = (u1 z + u0)^2
ring r2=0,(u1,u0,q2,q0),dp;
ideal I2 = u1^2-q2, 2*u1*u0, u0^2-q0;
ideal E2 = eliminate(I2, u1*u0);
"E2 (computed):"; print(std(E2));
"saturation of E2 by q2 (locus with q2 != 0):"; LIB "elim.lib"; print(sat(E2, ideal(q2))[1]);
quit;
